root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{bat,cmd,ps1}]
end_of_line = crlf

# rustfmt's own default, and what cargo fmt enforces.
[*.rs]
indent_size = 4
max_line_length = 100

[*.{js,ts,json,css,html,yml,yaml,toml}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[*.py]
indent_size = 4
