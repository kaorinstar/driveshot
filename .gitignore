# Build output. The whole workspace builds into target/ at the root; src-tauri is a member of
# it and has no build directory of its own.
/target/
/dist/
# Where release.yml gathers the installers before uploading them. A local run of that step
# leaves the same folder behind.
/artifacts/

# Generated by tauri-build from tauri.conf.json and the capability files. Nothing in here is
# written by hand, and it is rebuilt on every build.
/src-tauri/gen/

# Dependencies
node_modules/

# Editors
.vs/
.idea/
.vscode/

# Misc
*.log
.DS_Store
Thumbs.db
